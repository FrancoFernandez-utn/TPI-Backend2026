# Copiar como .env para cambiar valores. Todos tienen un valor por defecto en docker-compose.yml.

# Proveedor climatico: openmeteo (pronostico real, requiere Internet) o simulado (escenarios fijos para la demo)
CLIMA_PROVEEDOR=openmeteo

# Datos de demostracion (mision COMPLETADA historica para RN-10). Para no cargarlos: classpath:db/migration
FLYWAY_LOCATIONS=classpath:db/migration,classpath:db/demo

# Credenciales de desarrollo. Cambiarlas fuera del entorno de la materia.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
CAMPOS_DB_PASSWORD=campos_pass
MISIONES_DB_PASSWORD=misiones_pass
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
# Debe coincidir con el secreto del cliente ms-misiones en infra/keycloak/realm-agrodrones.json
MS_MISIONES_CLIENT_SECRET=ms-misiones-secret
